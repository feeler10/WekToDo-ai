# 复制为 .env 后填写本地配置；不要提交包含真实密钥的 .env 文件。
APP_NAME=WekToDo Agent Service
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false
REDIS_URL=redis://localhost:6379/0
# Redis Checkpointer 的 RediSearch 索引要求使用 DB 0。
CHECKPOINT_REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
# 可选：OpenAI 兼容服务地址，例如 https://api.example.com/v1
LLM_BASE_URL=
# DeepSeek、千问等优先使用 json_mode；确认支持时可改为 function_calling 或 json_schema。
LLM_STRUCTURED_OUTPUT_METHOD=json_mode
TASK_PARSE_MAX_ATTEMPTS=3
# 意图分类仅支持 llm；rule、semantic、hybrid 为保留值，选择后会明确报错。
INTENT_CLASSIFIER_PROVIDER=llm
INTENT_MODEL_NAME=qwen-flash
INTENT_MODEL_TEMPERATURE=0
INTENT_MODEL_MAX_TOKENS=200
# 千问 OpenAI 兼容接口关闭思考模式；由 extra_body 传给模型服务。
INTENT_MODEL_ENABLE_THINKING=false
# 任务定位默认使用可解释的关键词匹配；vector、hybrid 尚未实现并会明确报错。
TASK_MATCHER_PROVIDER=keyword
# 查询澄清和候选选择的短期 Checkpoint 状态过期秒数。
PENDING_CONTEXT_TTL_SECONDS=900
# 唯一任务焦点的短期 Checkpoint 状态过期秒数。
ACTIVE_TASK_CONTEXT_TTL_SECONDS=1800
# 创建草稿最多允许的澄清轮数。
TASK_DRAFT_CLARIFICATION_MAX_ROUNDS=4
TASK_UPDATE_CLARIFICATION_MAX_ROUNDS=4
